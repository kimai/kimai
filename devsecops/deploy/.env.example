# Deployment configuration for the local test environment.
# Copy to .env (deploy.sh does this automatically with random secrets).
# NEVER commit the real .env - it is excluded via devsecops/deploy/.gitignore

# REQUIRED: long random character sequence (deploy.sh generates one)
APP_SECRET=

# Database credentials for the internal MariaDB container
DB_NAME=kimai
DB_USER=kimai
DB_PASSWORD=
DB_ROOT_PASSWORD=
